// ! PLACE YOUR CUSTOM CONFIGURATION ELSEWHERE !

input {
    focus-follows-mouse max-scroll-amount="0%"
    mouse {
        accel-speed 0.0
        accel-profile "adaptive"
    }
    touchpad {
        tap
        accel-speed 0.0
        dwt
        middle-emulation
    }
    keyboard {
        xkb {
            layout "gb"
        }
        repeat-delay 200
    }
}
